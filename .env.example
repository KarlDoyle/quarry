# Copy to .env and adjust. Never commit your real .env.
# Everything has sensible defaults — you only need this file to change them.

# --- analyze: which LLM answers questions ---
# Default is LOCAL Ollama (free, on-device, no API key). Just run `ollama serve`
# and `ollama pull llama3.1`. Override the model if you prefer another:
# DEVTOOL_MODEL=llama3.1
# OLLAMA_HOST=http://127.0.0.1:11434

# To use the paid Anthropic API instead (billed per token, separate from any
# Claude subscription), set the provider AND a key:
# DEVTOOL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# DEVTOOL_MODEL=claude-3-5-haiku-latest

# --- storage ---
# Where the local index DB + cloned repos live (defaults to ./data).
# DEVTOOL_DATA_DIR=./data
