{
  "name": "quarry",
  "version": "0.2.0",
  "description": "Local-first semantic + keyword code search and ticket triage. Index any repo, ask questions or triage a Jira ticket, get grounded answers — no SaaS, no database server, no API key.",
  "type": "module",
  "bin": {
    "quarry": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "coverage": "NODE_OPTIONS=--experimental-sqlite vitest run --coverage",
    "eval": "NODE_OPTIONS=--experimental-sqlite tsx scripts/eval.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@xenova/transformers": "^2.17.2",
    "commander": "^12.1.0",
    "moss": "link:[private sibling link redacted]",
    "simple-git": "^3.27.0",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.5.2"
}
