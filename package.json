{
  "name": "devtool-rag",
  "version": "0.1.0",
  "description": "Local-first semantic code search + LLM analysis. Index any repo, ask questions, get grounded answers — no SaaS, no Docker.",
  "type": "module",
  "bin": {
    "devtool-rag": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.7.0",
    "commander": "^12.1.0",
    "simple-git": "^3.27.0",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
